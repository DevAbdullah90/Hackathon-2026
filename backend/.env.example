# ===========================================================================
# CIRO — Urban Flood Response Orchestrator
# Environment Variables
#
# ⚠️  NEVER commit this file to GitHub. It is already in .gitignore.
# Copy this file to .env and fill in your real API keys.
# ===========================================================================

LLM_PROVIDER=provider_name
# ---------------------------------------------------------------------------
# AI Brain — Gemini 2.0 Flash
# Get from: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Google Maps — Server-side key (Distance Matrix API + Geocoding API)
# Get from: https://console.cloud.google.com/apis/credentials
# Required APIs to enable:
#   - Distance Matrix API
#   - Geocoding API
# ---------------------------------------------------------------------------
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# ---------------------------------------------------------------------------
# OpenWeatherMap — Weather alerts & precipitation data
# Get from: https://home.openweathermap.org/api_keys
# Free tier: 1,000 calls/day (sufficient for hackathon)
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ---------------------------------------------------------------------------
# SerpApi — Google Search/News wrapper (used by search_local_news tool)
# Get from: https://serpapi.com/dashboard
# ---------------------------------------------------------------------------
SERP_API_KEY=your_serp_api_key_here

# ---------------------------------------------------------------------------
# Database — PostgreSQL (Neon Serverless)
# Setup by: Quratulain (Phase 1)
# Format: postgcirol+asyncpg://user:password@host/dbname
# ---------------------------------------------------------------------------
DATABASE_URL=postgcirol+asyncpg://user:password@host/ciro_db
